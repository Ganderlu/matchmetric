# Firebase web app configuration (public identifiers only)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Storage bucket (e.g. your-project.appspot.com), used for profile pictures.
# Leave empty to disable profile-picture uploads; the Profile page states this honestly
# instead of failing silently.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Optional Profile page destinations. With none set the Profile page says support and
# legal documents are not published yet rather than inventing contact details or links.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_APP_VERSION=

# Firebase Admin SDK credentials (server only; never use NEXT_PUBLIC_ here)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Football data provider (server only; never prefix with NEXT_PUBLIC_).
# The app reads these through the gated /api/football/* routes, so the key never
# reaches the browser.
#
#   FOOTBALL_PROVIDER=sportmonks   # or: api-football | demo
#   SPORTMONKS_API_KEY=...         # Sportmonks token
#   APIFOOTBALL_API_KEY=...        # API-Football key
#
# With no key set the app runs in "unconfigured" mode: it says so in the UI and shows
# clearly-labelled mock fixtures instead of inventing data. Setting a key activates the
# provider with no code changes.
FOOTBALL_PROVIDER=
SPORTMONKS_API_KEY=
APIFOOTBALL_API_KEY=
